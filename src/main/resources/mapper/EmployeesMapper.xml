<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.web.mapper.EmployeesMapper">
<!-- namespace: XML 파일에서 내용의 구분을 위해서 사용 -->

	<!-- 아이디 중복검사 -->
	<!-- <select id="checkId" parameterType="string" resultType="_int">
	
		select count(*) from tb_member where member_id = #{member_id}
	
	</select> -->

	<!-- 회원가입 -->
	<!-- <insert id="insertMember" parameterType="EmployeesVO">
	
		insert into tb_member (member_name,member_id,member_pw,phone,birthday)
				 values (#{member_name}, #{member_id}, #{member_pw}, #{phone},#{birthday})
	
	</insert>  -->
	
	<!-- 로그인(비밀번호 암호화 전) 
	<select id="login" parameterType="map" resultType="EmployeesVO">
	
		select * from tb_member
			where member_id=#{member_id}
			and member_pw=#{member_pw}
			and member_status='N'
	
	</select> -->
	
    <!-- 비밀번호 조회 -->
    <select id="getPassword" parameterType="int" resultType="string">
        SELECT e_pw 
        FROM employees
        WHERE e_idx = #{e_idx}
    </select>

    <!-- 로그인 정보 조회 -->
    <select id="login" parameterType="int" resultType="com.human.web.vo.EmployeesVO">
        SELECT *
        FROM employees
        WHERE e_idx = #{e_idx}
    </select>

    <!-- 회원 정보 변경 -->
    <update id="updateEmployees" parameterType="com.human.web.vo.EmployeesVO">
        UPDATE employees 
        SET name = #{name},
            e_pw = #{e_pw}
        WHERE e_idx = #{e_idx}
    </update>

    <!-- 사원 목록 조회 -->
    <select id="getEmployeesList" resultType="com.human.web.vo.EmployeesVO">
        SELECT e.e_idx, e.name, hr.position, d.name AS depa
        FROM employees e
        LEFT JOIN emp_hr hr ON e.e_idx = hr.e_idx
        LEFT JOIN departments d ON hr.d_idx = d.d_idx
        ORDER BY e.e_idx ASC
    </select>

    <!-- 사원 정보 조회 -->
    <select id="getEmployees" parameterType="int" resultType="com.human.web.vo.EmployeesVO">
        SELECT e.*, hr.position, d.name AS depa
        FROM employees e
        LEFT JOIN emp_hr hr ON e.e_idx = hr.e_idx
        LEFT JOIN departments d ON hr.d_idx = d.d_idx
        WHERE e.e_idx = #{e_idx}
    </select>

    <select id="getEmployeeDetails" parameterType="int" resultType="com.human.web.vo.EmployeesVO">
        SELECT DISTINCT e.*, hr.*, f.*, d.name AS depa
        FROM employees e
        LEFT JOIN emp_hr hr ON e.e_idx = hr.e_idx
        LEFT JOIN emp_financial f ON e.e_idx = f.e_idx
        LEFT JOIN departments d ON hr.d_idx = d.d_idx
        WHERE e.e_idx = #{e_idx}
    </select>

</mapper>	
