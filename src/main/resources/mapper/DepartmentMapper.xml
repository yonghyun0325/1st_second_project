<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.human.web.mapper.DepartmentMapper">

    <!-- 부서 목록 조회 -->
    <select id="getAllDepartments" resultType="com.human.web.vo.DepartmentVO">
        SELECT *
        FROM departments
    </select>

    <!-- 부서 등록 -->
    <insert id="insertDepartment" parameterType="com.human.web.vo.DepartmentVO">
        INSERT INTO departments (name)
        VALUES (#{name})
    </insert>

    <!-- ID로 부서 조회 -->
    <select id="getDepartmentById" parameterType="int" resultType="com.human.web.vo.DepartmentVO">
        SELECT *
        FROM departments
        WHERE d_idx = #{d_idx}
    </select>

    <!-- 부서 수정 -->
    <update id="updateDepartment" parameterType="com.human.web.vo.DepartmentVO">
        UPDATE departments
        SET name = #{name}
        WHERE d_idx = #{d_idx}
    </update>

    <!-- 부서 삭제 -->
    <delete id="deleteDepartment" parameterType="int">
        DELETE FROM departments
        WHERE d_idx = #{d_idx}
    </delete>

</mapper>
